{
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Methods": "GET, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/screenshots/*", "/img/*", "/*.js", "/*.css", "/admin/*", "/api/*"]
  }
}
